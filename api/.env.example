NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# true quando atrás de proxy/load balancer (usa X-Forwarded-For para IP do rate limit)
TRUST_PROXY=false

# Origens do web permitidas (CORS e checagem de Origin nas rotas que leem cookie), separadas por vírgula
WEB_ORIGINS=http://localhost:5173

# Segredos: mínimo 32 bytes. Gere com: openssl rand -base64 48
COOKIE_SECRET=change-me-change-me-change-me-change-me
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=api
JWT_AUDIENCE=app
# Desligue só em http://localhost (cookies Secure exigem HTTPS)
COOKIE_SECURE=false

# Porta do Postgres no host (docker-compose)
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Banco dos testes de integração (pnpm test:integration); criado automaticamente
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test

# HMAC dos códigos de verificação (mínimo 32 bytes)
CODE_HASH_SECRET=change-me-change-me-change-me-change-me

# console (dev: código aparece no log) | resend
EMAIL_PROVIDER=console
EMAIL_FROM=App <onboarding@resend.dev>
RESEND_API_KEY=

# URLs públicas. O redirect_uri do OAuth é API_URL/auth/oauth/:provider/callback;
# depois do OAuth web o navegador volta para WEB_URL/auth/callback.
API_URL=http://localhost:3333
WEB_URL=http://localhost:5173

# Google (preencha as duas ou nenhuma). Veja o README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client IDs iOS/Android aceitos como audience do id_token (separados por vírgula)
GOOGLE_MOBILE_CLIENT_IDS=

# Apple (preencha as quatro ou nenhuma). Veja o README.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo do .p8 em uma linha, com \n no lugar das quebras
APPLE_PRIVATE_KEY=
# Bundle IDs iOS aceitos como audience do id_token (separados por vírgula)
APPLE_BUNDLE_IDS=
