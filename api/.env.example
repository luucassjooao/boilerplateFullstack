NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# true quando atrás de proxy/load balancer (usa X-Forwarded-For para IP do rate limit)
TRUST_PROXY=false

# Origens do web permitidas (CORS e checagem de Origin nas rotas que leem cookie), separadas por vírgula
WEB_ORIGINS=http://localhost:5173

# Segredos: mínimo 32 bytes. Gere com: openssl rand -base64 48
COOKIE_SECRET=change-me-change-me-change-me-change-me
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=api
JWT_AUDIENCE=app
