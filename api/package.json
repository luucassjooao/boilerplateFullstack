{
  "name": "api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#application/*": {
      "source": "./src/application/*.ts",
      "default": "./dist/application/*.js"
    },
    "#infra/*": {
      "source": "./src/infra/*.ts",
      "default": "./dist/infra/*.js"
    },
    "#main/*": {
      "source": "./src/main/*.ts",
      "default": "./dist/main/*.js"
    },
    "#shared/*": {
      "source": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#tests/*": "./tests/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/main/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/infra/database/drizzle/migrations dist/infra/database/drizzle/",
    "start": "node --env-file-if-exists=.env dist/main/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=.env src/main/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/main/migrate.js",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "resend": "^6.32.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
