{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": {
      "@app/*": ["./src/app/*"],
      "@ui/*": ["./src/ui/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
