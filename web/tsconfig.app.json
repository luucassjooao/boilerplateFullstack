{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@router/*": [
        "./src/router/*"
      ],
      "@test/*": [
        "./src/test/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
